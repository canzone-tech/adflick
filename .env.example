NODE_ENV=development
APP_NAME=ADFLICK PLAYOUT CMS
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1

# Local development only. Replace credentials before shared use.
MYSQL_DATABASE=adflick_playout
MYSQL_USER=adflick_app
MYSQL_PASSWORD=change_me_local_password
MYSQL_ROOT_PASSWORD=change_me_local_root_password
DATABASE_URL=mysql://adflick_app:change_me_local_password@localhost:3306/adflick_playout

REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes_before_use
JWT_REFRESH_SECRET=replace_with_a_different_32_random_bytes_before_use
# Production: dedicated 32-byte base64url key for encrypting MFA authenticator secrets.
MFA_ENCRYPTION_KEY=replace_with_a_32_byte_base64url_key
MFA_STEP_UP_TTL_SECONDS=600
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_MAX_ATTEMPTS=5
MFA_ENROLLMENT_TTL_SECONDS=900
MFA_TOTP_STEP_SECONDS=30
MFA_TOTP_WINDOW_STEPS=1
MFA_RECOVERY_CODE_COUNT=10

# BATCH 02 auth settings
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
DEMO_SEED_PASSWORD=change_me_demo_seed_password

# BATCH 03: S3-compatible object storage (MinIO, AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=adflick-media
S3_ACCESS_KEY_ID=change_me_minio_access
S3_SECRET_ACCESS_KEY=change_me_minio_secret

# BATCH 08 scheduler; keep one API replica until distributed leader locking exists.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# BATCH 11 automated health alert scanning (runs as part of the scheduler cycle).
ALERT_SCAN_ENABLED=true

# Web application browser-visible API base; configure at build/runtime for your deployment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Optional BATCH 11/12 incident webhook adapter. Leave empty to disable notifications.
# Use HTTPS and explicitly allowlist exact hostnames. Do not allow arbitrary/private hosts.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
ALERT_WEBHOOK_BEARER_TOKEN=

# Durable notification outbox worker
NOTIFICATION_OUTBOX_ENABLED=true
NOTIFICATION_OUTBOX_INTERVAL_MS=15000

NODE_ENV=development
APP_NAME=ADFLICK PLAYOUT CMS
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1

# Local development only. Replace credentials before shared use.
MYSQL_DATABASE=adflick_playout
MYSQL_USER=adflick_app
MYSQL_PASSWORD=change_me_local_password
MYSQL_ROOT_PASSWORD=change_me_local_root_password
DATABASE_URL=mysql://adflick_app:change_me_local_password@localhost:3306/adflick_playout

REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes_before_use
JWT_REFRESH_SECRET=replace_with_a_different_32_random_bytes_before_use
# Production: dedicated 32-byte base64url key for encrypting MFA authenticator secrets.
MFA_ENCRYPTION_KEY=replace_with_a_32_byte_base64url_key
MFA_STEP_UP_TTL_SECONDS=600
MFA_CHALLENGE_TTL_SECONDS=300
MFA_CHALLENGE_MAX_ATTEMPTS=5
MFA_ENROLLMENT_TTL_SECONDS=900
MFA_TOTP_STEP_SECONDS=30
MFA_TOTP_WINDOW_STEPS=1
MFA_RECOVERY_CODE_COUNT=10

# BATCH 02 auth settings
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
DEMO_SEED_PASSWORD=change_me_demo_seed_password

# BATCH 03: S3-compatible object storage (MinIO, AWS S3, Cloudflare R2, etc.)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=adflick-media
S3_ACCESS_KEY_ID=change_me_minio_access
S3_SECRET_ACCESS_KEY=change_me_minio_secret

# BATCH 08 scheduler; keep one API replica until distributed leader locking exists.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=60000

# BATCH 11 automated health alert scanning (runs as part of the scheduler cycle).
ALERT_SCAN_ENABLED=true

# Web application browser-visible API base; configure at build/runtime for your deployment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Optional BATCH 11/12 incident webhook adapter. Leave empty to disable notifications.
# Use HTTPS and explicitly allowlist exact hostnames. Do not allow arbitrary/private hosts.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
ALERT_WEBHOOK_BEARER_TOKEN=

# Durable notification outbox worker
NOTIFICATION_OUTBOX_ENABLED=true
NOTIFICATION_OUTBOX_INTERVAL_MS=15000

# SRS Member enrollment (DEFAULT OFF; never enable without approved product/legal/issuance policies)
ADFLICK_MEMBER_CONFIG_ENABLED=false
ADFLICK_MEMBER_EPIN_ISSUANCE_ENABLED=false
ADFLICK_MEMBER_ENROLLMENT_ENABLED=false
# Dedicated secret, min 32 characters; set through protected secret manager only:
# ADFLICK_EPIN_HASH_PEPPER=<set in environment, never commit>

# OTP/email verification — ALL OFF until independently authorized.
# SMTP credentials MUST be private environment secrets, never saved in Git, SQL or UI.
ADFLICK_MEMBER_OTP_POLICY_ENABLED=false
ADFLICK_MEMBER_EMAIL_OTP_ENABLED=false
ADFLICK_MEMBER_OTP_HOURLY_CAP=10
# Dedicated HMAC pepper (min 32 characters), distinct from e-PIN/JWT/MFA keys:
# ADFLICK_MEMBER_OTP_HASH_PEPPER=<set privately, never commit>
ADFLICK_SMTP_ENABLED=false
ADFLICK_SMTP_HOST=
ADFLICK_SMTP_PORT=587
ADFLICK_SMTP_SECURE=false
ADFLICK_SMTP_FROM_EMAIL=
ADFLICK_SMTP_FROM_NAME=ADFLICK
ADFLICK_SMTP_USERNAME=
ADFLICK_SMTP_PASSWORD=
# Non-production test transport only. Do NOT set on real servers.
ADFLICK_SMTP_INSECURE_LOOPBACK_TEST=false

# Public Join Now verified-account bootstrap (all DEFAULT OFF).
# Requires approved operator policy, tenant policy, legal consent and working SMTP.
ADFLICK_PUBLIC_SIGNUP_POLICY_ENABLED=false
ADFLICK_PUBLIC_SIGNUP_ENABLED=false
# Dedicated private HMAC key, 32+ characters and distinct from JWT/OTP/PIN:
# ADFLICK_PUBLIC_SIGNUP_HMAC_SECRET=<set privately via secret manager>

# Phone/mobile SMS OTP — strictly DEFAULT OFF, no provider is assumed.
# SMS provider/commercial/template approvals and independent device UAT required.
ADFLICK_MEMBER_PHONE_OTP_ENABLED=false
ADFLICK_SMS_ENABLED=false
ADFLICK_SMS_PROVIDER_APPROVED=false
ADFLICK_SMS_GATEWAY_URL=
ADFLICK_SMS_GATEWAY_BEARER_TOKEN=
ADFLICK_SMS_SENDER_ID=
ADFLICK_SMS_OTP_TEMPLATE=
ADFLICK_SMS_INSECURE_LOOPBACK_TEST=false
ADFLICK_MEMBER_PHONE_OTP_TTL_SECONDS=300
ADFLICK_MEMBER_PHONE_OTP_RESEND_SECONDS=60
ADFLICK_MEMBER_PHONE_OTP_MAX_ATTEMPTS=5
ADFLICK_MEMBER_PHONE_OTP_HOURLY_CAP=10
# Dedicated private keys, set only in secret store:
# ADFLICK_MEMBER_PHONE_OTP_HASH_PEPPER=<min 32 chars, independent of e-PIN/JWT/email>
# ADFLICK_MEMBER_PHONE_DATA_KEY=<32-byte base64url AES-256-GCM key>

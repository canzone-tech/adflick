{
  "name": "@adflick/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --config ./jest.config.cjs --runInBand",
    "test:e2e:security": "jest --config ./jest.config.cjs --runInBand --testRegex '.*[.]e2e-spec[.]ts$' --runTestsByPath test/security.e2e-spec.ts",
    "test:e2e:finance": "jest --config ./jest.config.cjs --runInBand --testRegex '.*[.]e2e-spec[.]ts$' --runTestsByPath test/finance-transaction.mysql.e2e-spec.ts test/reconciliation-import.mysql.e2e-spec.ts test/reconciliation-import.http.e2e-spec.ts",
    "test:e2e:members": "jest --config ./jest.config.cjs --runInBand --testRegex '.*[.]e2e-spec[.]ts$' --runTestsByPath test/members.mysql.e2e-spec.ts test/enrollment.mysql.e2e-spec.ts test/member-email-otp.mysql.e2e-spec.ts test/public-signup.mysql.e2e-spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@nestjs/jwt": "^11.0.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "@nestjs/passport": "^11.0.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "dotenv": "^16.6.1",
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "file-type": "^21.0.0",
    "mime-types": "^3.0.1",
    "sharp": "^0.34.3",
    "@nestjs/throttler": "^6.4.0",
    "nodemailer": "10.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.6",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "eslint": "^9.35.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "@types/passport-jwt": "^4.0.1",
    "typescript-eslint": "^8.44.1",
    "@types/mime-types": "^2.1.4"
  }
}

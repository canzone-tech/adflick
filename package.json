{
  "name": "adflick-playout-cms",
  "version": "0.1.0",
  "private": true,
  "description": "ADFLICK PLAYOUT CMS monorepo",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test:api": "npm run test -w apps/api",
    "typecheck:api": "npx tsc --noEmit -p apps/api/tsconfig.json",
    "typecheck:web": "npx tsc --noEmit -p apps/web/tsconfig.json",
    "check:source": "node scripts/check-source.mjs && node --test scripts/check-regression-contracts.test.mjs && node scripts/check-regression-contracts.mjs && node scripts/check-source-provenance.mjs && npm run check:ui && node --test scripts/android-player-contract.test.mjs && node --test scripts/client-platform-contract.test.mjs && node --test scripts/live-operations-contract.test.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "verify:release": "npm run check:source && npm run validate:env && npx prisma validate && npm run typecheck:api && npm run typecheck:web && npm run lint && npm run test:api && npm run build:api && npm run build:web",
    "test:e2e:security": "npm run test:e2e:security -w apps/api",
    "test:e2e:finance": "npm run test:e2e:finance -w apps/api",
    "verify:reconciliation:release": "node scripts/run-reconciliation-release-gate.mjs",
    "verify:dependencies": "node scripts/verify-dependency-install.mjs",
    "verify:clean-release": "node scripts/verify-clean-release.mjs",
    "verify": "node scripts/verify.mjs --all",
    "verify:backend": "node scripts/verify.mjs --backend",
    "verify:frontend": "node scripts/verify.mjs --frontend",
    "test:api:coverage": "npm run test -w apps/api -- --coverage --coverageReporters=text-summary --coverageReporters=json-summary --coverageReporters=html",
    "local:up": "node scripts/local-runtime.mjs",
    "local:uat": "node scripts/local-runtime.mjs --browser-uat",
    "local:dev:up": "node scripts/local-runtime.mjs --persistent-dev",
    "local:dev:admin": "node scripts/local-dev-admin.mjs",
    "local:dev:test": "node --test scripts/first-admin.test.mjs scripts/read-hidden-password.test.mjs",
    "local:dev:integration": "node scripts/local-dev-integration.mjs",
    "local:dev:uat": "node scripts/local-runtime.mjs --persistent-dev-uat",
    "check:ui": "node scripts/check-ui-shell.mjs"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "typescript": "^5.9.2",
    "tsx": "^4.20.5",
    "dotenv": "^16.6.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
